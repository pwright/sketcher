{
"id": "sketcher-architecture",
"title": "Sketcher Testing Framework",
"abstract": "Sketcher enables users to test and document Skupper multi-site deployments through declarative YAML files. Users define sites (Kubernetes, Podman, Docker) and steps, then Sketcher generates documentation (Python tool) and executes tests (Go tool) across multiple clusters/platforms, managing cluster lifecycle, networking, and cleanup.",
"categories": [
{
"id": "user-workflows",
"title": "User Workflows",
"items": [
{
"id": "demo-extensions",
"name": "Demo Extensions",
"deps": [
"sketcher-go"
],
"color": "#4CAF50"
},
{
"id": "automated-testing",
"name": "CI/CD Testing",
"deps": [
"skewer-python",
"sketcher-go"
],
"external": "[https://github.com/pwright/sketcher#cicd-integration](https://github.com/pwright/sketcher#cicd-integration)"
},
{
"id": "documentation",
